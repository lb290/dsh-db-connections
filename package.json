{
  "name": "dsh-db-connections",
  "version": "0.2.0",
  "private": true,
  "description": "Named database connections for DeepSeek Harness: configure MySQL, Doris, PostgreSQL, and TDengine in a settings page, then refer to them by name in chat (for example \"query 128\"). Read-only by default, with writes opt-in per connection.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "tests/"
  ],
  "scripts": {
    "test": "node tests/run-tests.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "database",
    "mysql",
    "doris",
    "postgresql",
    "tdengine",
    "sql"
  ],
  "license": "MIT",
  "icon": "./icon.svg",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "dependencies": {
    "mysql2": "^3.24.6",
    "yaml": "^2.9.1"
  },
  "optionalDependencies": {
    "pg": "^8.13.0"
  }
}
